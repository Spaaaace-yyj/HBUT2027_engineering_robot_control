<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="rm_engineering_robot">

    <!--使用实车硬件接口还是isaac接口-->
    <xacro:arg name="hardware_type" default="real"/>

    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import rm_engineering_robot urdf file -->
    <xacro:include filename="$(find rm_engineering_robot_description)/urdf/rm_engineering_robot.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="rm_engineering_robot.ros2_control.xacro" />


    <xacro:rm_engineering_robot_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)" hardware_type="$(arg hardware_type)"/>

</robot>
