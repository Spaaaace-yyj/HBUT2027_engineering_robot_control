<?xml version="1.0"?>
<package format="3">
  <name>foundationpose_shm_bridge</name>
  <version>0.2.0</version>
  <description>
    ROS 2 bridge for FoundationPose: ZED RGB-D shared memory input, service/parameter
    control, pose/debug/mask result publishing, and TF broadcasting.
  </description>

  <maintainer email="maintainer@example.com">spaaaaace</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>cv_bridge</depend>
  <depend>message_filters</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>opencv</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
